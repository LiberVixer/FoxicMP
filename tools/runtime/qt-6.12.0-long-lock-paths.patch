+// Keep explicit long user TMP paths even on hosts where GetTempPathW either
+// falls back to USERPROFILE or blocks in a longPathAware process. LocalSystem
+// retains GetTempPath2W's security-specific SystemTemp directory selection.
+static QString longUserEnvironmentTempPath()
+{
+    HANDLE token = nullptr;
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token))
+        return {};
+    alignas(TOKEN_USER) unsigned char user[sizeof(TOKEN_USER) + SECURITY_MAX_SID_SIZE];
+    DWORD returned = 0;
+    const bool knownUser = GetTokenInformation(token, TokenUser, user, sizeof(user), &returned)
+            && !IsWellKnownSid(reinterpret_cast<TOKEN_USER *>(user)->User.Sid, WinLocalSystemSid);
+    CloseHandle(token);
+    if (!knownUser)
+        return {};
+
+    for (const auto variable : {L"TMP", L"TEMP", L"USERPROFILE"}) {
+        for (unsigned attempt = 0; attempt < 4; ++attempt) {
+            const DWORD capacity = GetEnvironmentVariableW(variable, nullptr, 0);
+            if (!capacity)
+                break;
+            if (capacity > 32768)
+                return {};
+            QVarLengthArray<wchar_t, MAX_PATH> selected(capacity);
+            const DWORD count = GetEnvironmentVariableW(variable, selected.data(), capacity);
+            if (count >= capacity)
+                continue;
+            if (!count)
+                break;
+            const DWORD fullCapacity = GetFullPathNameW(selected.data(), 0, nullptr, nullptr);
+            if (!fullCapacity || fullCapacity > 32768)
+                return {};
+            QVarLengthArray<wchar_t, MAX_PATH> full(fullCapacity);
+            const DWORD fullCount = GetFullPathNameW(selected.data(), fullCapacity, full.data(), nullptr);
+            if (!fullCount || fullCount >= fullCapacity)
+                return {};
+            // The first nonempty variable stays authoritative, even if short.
+            return fullCount >= MAX_PATH ? QString::fromWCharArray(full.data(), fullCount) : QString();
+        }
+        if (GetEnvironmentVariableW(variable, nullptr, 0) > 1)
+            return {}; // An unstable environment must not select a lower-priority root.
+    }
+    return {};
+}
